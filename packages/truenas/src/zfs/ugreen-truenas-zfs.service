[Unit]
Description=Drive UGREEN front-panel LEDs from TrueNAS ZFS status
After=pve-guests.service

[Service]
Type=simple
EnvironmentFile=/etc/ugreen-dxp-pve-truenas-zfs.conf
RuntimeDirectory=ugreen-dxp-pve/zfs
ExecStart=/usr/local/bin/ugreen-truenas-zfs.py --start
Restart=on-failure
RestartSec=10s
Nice=10

[Install]
WantedBy=multi-user.target
