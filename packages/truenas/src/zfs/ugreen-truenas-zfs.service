[Unit]
Description=Publish UGREEN front-panel disk LED looks from TrueNAS ZFS status
After=pve-guests.service

[Service]
Type=simple
RuntimeDirectory=ugreen-dxp-leds/truenas-zfs
ExecStart=/usr/local/bin/ugreen-truenas-zfs.py --start
Restart=on-failure
RestartSec=10s
Nice=10

[Install]
WantedBy=multi-user.target
