#!/usr/bin/make -f

module = it87
package = ugreen-dxp-pve-it87-dkms

version := $(shell dpkg-parsechangelog | grep '^Version:' | cut -d' ' -f2 | rev | cut -d- -f2- | rev | cut -d':' -f2)

%:
	dh $@ --with dkms

override_dh_install:
	dh_installdirs -p$(package) usr/src/$(module)-$(version)
	dh_install -p$(package) Makefile usr/src/$(module)-$(version)
	dh_install -p$(package) compat.h usr/src/$(module)-$(version)
	dh_install -p$(package) it87.c usr/src/$(module)-$(version)
	dh_install -p$(package) debian/ugreen-dxp-pve-it87.conf etc/modules-load.d/
	printf '%s\n' '$(version)' > debian/$(package)/usr/src/$(module)-$(version)/VERSION

override_dh_dkms:
	dh_dkms -V $(version)

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:
override_dh_auto_clean:
