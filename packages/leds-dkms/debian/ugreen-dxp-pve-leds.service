[Unit]
Description=Manage UGREEN DXP power LED faults and configure network/disk LEDs
Documentation=https://github.com/lpaolini/ugreen-dxp
Requires=ugreen-dxp-pve-leds-dkms.service
After=ugreen-dxp-pve-leds-dkms.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/ugreen-dxp-pve-leds.conf
ExecStartPre=/usr/libexec/ugreen-dxp-pve-leds-dkms/configure-led-ugreen
ExecStart=/usr/libexec/ugreen-dxp-pve-leds-dkms/power-led-monitor-ugreen
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
