#!/bin/sh
set -e

CONF=/etc/ugreen-dxp-pve-leds.toml
TEMPLATE=/usr/share/ugreen-dxp-pve-leds/ugreen-dxp-pve-leds.toml
LEGACY_CONF=/etc/ugreen-dxp-pve-leds.conf.dpkg-bak

#DEBHELPER#

if [ "$1" = "configure" ]; then
    if [ ! -e "$CONF" ]; then
        install -m 0644 "$TEMPLATE" "$CONF"
    fi

    if [ -n "$2" ] && dpkg --compare-versions "$2" lt 0.4.0~; then
        # The old bind unit was named after the package.
        deb-systemd-helper purge ugreen-dxp-pve-leds-dkms.service >/dev/null || true

        if [ -f "$LEGACY_CONF" ]; then
            bus="$(sed -n 's/^[[:space:]]*I2C_BUS=["'\'']\{0,1\}\([0-9][0-9]*\).*/\1/p' "$LEGACY_CONF" | tail -n 1)"
            if [ -n "$bus" ] && ! grep -q '^[[:space:]]*i2c_bus[[:space:]]*=' "$CONF"; then
                printf '\n[bind]\ni2c_bus = %s\n' "$bus" >> "$CONF"
                echo "Migrated I2C_BUS=$bus from $LEGACY_CONF to $CONF"
            fi
            echo "LED colours and triggers are now configured in $CONF;"
            echo "review $LEGACY_CONF for customisations to carry over."
        fi
    fi

    # Start (or retry) after the template and any migrated bus are in place.
    deb-systemd-invoke start ugreen-dxp-pve-leds-bind.service ugreen-dxp-pve-leds.service >/dev/null || true
fi

exit 0
