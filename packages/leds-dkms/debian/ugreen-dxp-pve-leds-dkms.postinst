#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = "configure" ]; then
    if [ -x /usr/bin/deb-systemd-invoke ]; then
        deb-systemd-invoke stop ugreen-dxp-pve-leds-dkms-leds.service || true
    fi

    if [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper disable ugreen-dxp-pve-leds-dkms-leds.service >/dev/null || true
        deb-systemd-helper purge ugreen-dxp-pve-leds-dkms-leds.service >/dev/null || true
    fi
fi

if [ "$1" = "configure" ] && [ -x /usr/libexec/ugreen-dxp-pve-leds-dkms/probe-led-ugreen ]; then
    /usr/libexec/ugreen-dxp-pve-leds-dkms/probe-led-ugreen || true
fi

if [ "$1" = "configure" ] && [ -x /usr/libexec/ugreen-dxp-pve-leds-dkms/configure-led-ugreen ]; then
    /usr/libexec/ugreen-dxp-pve-leds-dkms/configure-led-ugreen || true
fi

exit 0
