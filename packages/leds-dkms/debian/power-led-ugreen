#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

DEFAULTS="${UGREEN_LED_DEFAULTS:-/etc/ugreen-dxp-pve-leds.conf}"

POWER_LED_STATE_DIR="/run/ugreen-dxp-pve-leds/power-led-faults"

if [ -r "$DEFAULTS" ]; then
    # shellcheck source=/dev/null
    . "$DEFAULTS"
fi

log() {
    printf '%s\n' "$*" >&2
}

usage() {
    log "Usage: $0 status|set-fault <name>|clear-fault <name>"
}

validate_fault_name() {
    case "${1:-}" in
        ""|*/*|*[^A-Za-z0-9_.-]*)
            log "Invalid power LED fault name: ${1:-}"
            return 1
            ;;
    esac
}

has_active_faults() {
    [ -d "$POWER_LED_STATE_DIR" ] || return 1

    for fault in "$POWER_LED_STATE_DIR"/*; do
        [ -e "$fault" ] || continue
        return 0
    done

    return 1
}

set_fault() {
    name="$1"
    validate_fault_name "$name" || return 2

    mkdir -p "$POWER_LED_STATE_DIR"
    printf '%s\n' "$name" > "$POWER_LED_STATE_DIR/$name"
}

clear_fault() {
    name="$1"
    validate_fault_name "$name" || return 2

    rm -f "$POWER_LED_STATE_DIR/$name"
}

show_status() {
    if has_active_faults; then
        printf 'fault'
        for fault in "$POWER_LED_STATE_DIR"/*; do
            [ -e "$fault" ] || continue
            printf ' %s' "$(basename "$fault")"
        done
        printf '\n'
    else
        printf 'normal\n'
    fi
}

case "${1:-}" in
    status)
        [ "$#" -eq 1 ] || { usage; exit 2; }
        show_status
        ;;
    set-fault)
        [ "$#" -eq 2 ] || { usage; exit 2; }
        set_fault "$2"
        ;;
    clear-fault)
        [ "$#" -eq 2 ] || { usage; exit 2; }
        clear_fault "$2"
        ;;
    *)
        usage
        exit 2
        ;;
esac
