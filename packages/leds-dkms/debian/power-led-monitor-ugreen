#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
import ctypes
import errno
import os
import select
import shlex
import signal
import string
import struct
import sys
import syslog


TAG = "power-led-ugreen"
DEFAULTS = os.environ.get("UGREEN_LED_DEFAULTS", "/etc/ugreen-dxp-pve-leds.conf")

CONFIG_DEFAULTS = {
    "POWER_LED_PATH": "/sys/class/leds/ugreen:white:power",
    "POWER_LED_NORMAL_TRIGGER": "none",
    "POWER_LED_NORMAL_BRIGHTNESS": "255",
    "POWER_LED_NORMAL_COLOR": "0 64 16",
    "POWER_LED_NORMAL_BLINK_TYPE": "none",
    "POWER_LED_FAULT_TRIGGER": "none",
    "POWER_LED_FAULT_BRIGHTNESS": "255",
    "POWER_LED_FAULT_COLOR": "80 0 0",
    "POWER_LED_FAULT_BLINK_TYPE": "blink 500 500",
    "POWER_LED_STATE_DIR": "/run/ugreen-dxp-pve-leds/power-led-faults",
}

IN_ACCESS = 0x00000001
IN_MODIFY = 0x00000002
IN_ATTRIB = 0x00000004
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_FROM = 0x00000040
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_IGNORED = 0x00008000
IN_CLOEXEC = 0o2000000

WATCH_MASK = (
    IN_CLOSE_WRITE
    | IN_MOVED_FROM
    | IN_MOVED_TO
    | IN_CREATE
    | IN_DELETE
    | IN_DELETE_SELF
    | IN_MOVE_SELF
    | IN_ATTRIB
)

EVENT_STRUCT = struct.Struct("iIII")


def log(message):
    syslog.syslog(message)
    print(f"[{TAG}] {message}", file=sys.stderr)


def parse_env_file(path):
    values = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                name, value = line.split("=", 1)
                name = name.strip()
                if not name:
                    continue
                try:
                    parts = shlex.split(value, comments=False, posix=True)
                except ValueError:
                    parts = [value]
                values[name] = parts[0] if parts else ""
    except FileNotFoundError:
        pass
    return values


def load_config():
    config = dict(CONFIG_DEFAULTS)
    config.update(parse_env_file(DEFAULTS))
    for name in CONFIG_DEFAULTS:
        if name in os.environ:
            config[name] = os.environ[name]
    return config


def normalize_color(color):
    value = color.strip()
    if value.startswith("#") and len(value) == 7:
        hex_value = value[1:]
    elif value[:2].lower() == "0x" and len(value) == 8:
        hex_value = value[2:]
    elif len(value) == 6:
        hex_value = value
    else:
        return color

    if any(c not in string.hexdigits for c in hex_value):
        return color
    r = int(hex_value[0:2], 16)
    g = int(hex_value[2:4], 16)
    b = int(hex_value[4:6], 16)
    return f"{r} {g} {b}"


def write_if_present(path, value):
    if not os.path.exists(path):
        log(f"Skipping missing LED attribute: {path}")
        return False
    try:
        with open(path, "w") as f:
            f.write(str(value) + "\n")
    except OSError as e:
        log(f"sysfs write failed: {path}={value!r}: {e}")
        return False
    return True


def has_active_faults(state_dir):
    try:
        with os.scandir(state_dir) as entries:
            return any(entry.name not in (".", "..") for entry in entries)
    except FileNotFoundError:
        return False


def apply_power_led(config):
    led_path = config["POWER_LED_PATH"]
    if not os.path.isdir(led_path):
        log(f"Power LED sysfs path missing: {led_path}")
        return False

    if has_active_faults(config["POWER_LED_STATE_DIR"]):
        attrs = (
            ("trigger", config["POWER_LED_FAULT_TRIGGER"]),
            ("brightness", config["POWER_LED_FAULT_BRIGHTNESS"]),
            ("color", normalize_color(config["POWER_LED_FAULT_COLOR"])),
            ("blink_type", config["POWER_LED_FAULT_BLINK_TYPE"]),
        )
    else:
        attrs = (
            ("trigger", config["POWER_LED_NORMAL_TRIGGER"]),
            ("blink_type", config["POWER_LED_NORMAL_BLINK_TYPE"]),
            ("brightness", config["POWER_LED_NORMAL_BRIGHTNESS"]),
            ("color", normalize_color(config["POWER_LED_NORMAL_COLOR"])),
        )

    ok = True
    for attr, value in attrs:
        ok = write_if_present(os.path.join(led_path, attr), value) and ok
    return ok


def request_stop(_signum, _frame):
    raise SystemExit(0)


def inotify_init():
    libc = ctypes.CDLL("libc.so.6", use_errno=True)
    fd = libc.inotify_init1(IN_CLOEXEC)
    if fd < 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))
    return libc, fd


def inotify_add_watch(libc, fd, path, mask):
    wd = libc.inotify_add_watch(fd, os.fsencode(path), mask)
    if wd < 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))
    return wd


def drain_events(fd):
    try:
        data = os.read(fd, 65536)
    except BlockingIOError:
        return False
    offset = 0
    interesting = False
    while offset + EVENT_STRUCT.size <= len(data):
        _wd, mask, _cookie, name_len = EVENT_STRUCT.unpack_from(data, offset)
        offset += EVENT_STRUCT.size + name_len
        if mask & WATCH_MASK:
            interesting = True
    return interesting


def run_monitor():
    config = load_config()
    state_dir = config["POWER_LED_STATE_DIR"]
    os.makedirs(state_dir, exist_ok=True)
    apply_power_led(config)

    libc, fd = inotify_init()
    try:
        inotify_add_watch(libc, fd, state_dir, WATCH_MASK)
        log(f"monitoring power LED fault state: {state_dir}")
        while True:
            readable, _, _ = select.select([fd], [], [], None)
            if fd not in readable:
                continue
            if drain_events(fd):
                apply_power_led(load_config())
    finally:
        os.close(fd)


def main():
    syslog.openlog(TAG)
    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    try:
        run_monitor()
    except OSError as e:
        if e.errno == errno.ENOSYS:
            log("inotify is not available")
        else:
            log(str(e))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
